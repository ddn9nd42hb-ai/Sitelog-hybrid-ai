# Firebase web config (Project settings → Your apps → SDK setup and configuration).
# These values are public identifiers, not secrets: protection comes from App Check
# and security rules. Still, keep this file out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v3 site key registered for App Check (production builds).
VITE_RECAPTCHA_SITE_KEY=

# Local development only: a fixed App Check debug token, safelisted in the console.
# Do NOT commit this value and do NOT ship it in a public build.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: override the cloud model used for the in-cloud half of the hybrid.
# Default: gemini-3.5-flash-lite
VITE_CLOUD_MODEL=
